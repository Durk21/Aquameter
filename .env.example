APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Required in production, alongside APP_ENV=production and
# APP_DEBUG=false: set SESSION_SECURE_COOKIE=true so the session cookie
# is only ever sent over HTTPS. Left unset here since local development
# normally runs over plain HTTP and Laravel treats an unset value as
# false — an unset/false value would silently allow the session cookie
# over HTTP in production too.
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Scaling past a single app server: database-backed session/cache/queue
# (the defaults above) work fine at moderate load but add DB pressure
# and don't fit a multi-server deployment as cleanly as Redis. Point
# REDIS_HOST/PASSWORD/PORT above at a real Redis instance, then switch:
# SESSION_DRIVER=redis
# CACHE_STORE=redis
# QUEUE_CONNECTION=redis

# Evidence photos are stored on FILESYSTEM_DISK by default (see
# config/utility.php's photo_disk). Local disk isn't shared between
# app servers, so once you're running more than one, point photos at
# S3 instead — either flip FILESYSTEM_DISK=s3 above, or set PHOTO_DISK
# on its own to move only photos while leaving everything else local.
# Fill in the AWS_* credentials below either way.
# PHOTO_DISK=s3

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Required for the "Ask Aquameter" chat assistant. Without it, the
# assistant responds with a friendly "not configured yet" message
# instead of attempting a call. Get a key at platform.openai.com.
# Any OpenAI-compatible provider works too (e.g. Groq, which has a
# free tier with no billing setup) — just set OPENAI_BASE_URL and
# OPENAI_CHAT_MODEL to match the provider.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=gpt-4o-mini

VITE_APP_NAME="${APP_NAME}"
